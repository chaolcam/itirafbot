# Onay Grubu ID'si (Botun ve adminlerin olduğu grup)
ADMIN_GROUP_ID=-1003791676374

# Paylaşılacak Hedef Kanal ID'si (Botun admin olduğu kanal)
TARGET_CHANNEL_ID=-1003983042944

# Kanal Kullanıcı Adı (Opsiyonel, @ olmadan. Kanal gizliyse boş bırakılabilir)
CHANNEL_USERNAME=resimpuanla

# Kanala Katılma / Davet Bağlantısı (Zorunlu katılım butonunda açılacak link)
CHANNEL_INVITE_LINK=https://t.me/resimpuanla

# Yedek Kanal ID'si (Opsiyonel)
